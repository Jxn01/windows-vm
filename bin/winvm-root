#!/usr/bin/python3 -I
"""winvm-root - the root half of winvm, and the libvirt qemu hook's entry point.

ALWAYS runs the root-owned installed copy (/usr/local/lib/windows-vm), never code from the shared tree:
~/Projects is on an NTFS drive that jxn and the Windows half can write, and root must not execute that.
"""
import sys

sys.path.insert(0, "/usr/local/lib/windows-vm")
from winvm.rootcmd import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
